# Порт сервера Express
PORT=8080

# Адреса, з якої будуються короткі посилання
BASE_URL=http://localhost:8080

# Налаштування PostgreSQL (їх читає і контейнер бази, і наш сервер)
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change_me
POSTGRES_DB=shortener

# Де шукати базу. У Docker — за іменем сервісу "db"
DB_HOST=db
DB_PORT=5432